{
  "toolSearchTool": {
    "implementation": "tool_search_tool_bm25_20251119",
    "description": "BM25-based semantic search for 47+ skills + 11 MCPs. Defers loading non-hot tools on-demand. Reduces context bloat ~85%.",
    "hotTools": [
      "ad-creative",
      "claude-ads",
      "paid-ads",
      "social-content",
      "copywriting",
      "email-sequence"
    ],
    "deferAllOthers": true
  },
  "mcpServers": {
    "pipeboard-meta-ads": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://mcp.pipeboard.co/meta-ads-mcp",
        "--header",
        "Authorization:Bearer ${PIPEBOARD_API_TOKEN}"
      ],
      "env": {
        "PIPEBOARD_API_TOKEN": "${PIPEBOARD_API_TOKEN}"
      }
    },
    "google-ads": {
      "command": "python",
      "args": [
        "${GOOGLE_ADS_MCP_PATH}/google_ads_server.py"
      ],
      "env": {
        "GOOGLE_ADS_CREDENTIALS_PATH": "${GOOGLE_ADS_CREDENTIALS_PATH}",
        "GOOGLE_ADS_DEVELOPER_TOKEN": "${GOOGLE_ADS_DEVELOPER_TOKEN}",
        "GOOGLE_ADS_LOGIN_CUSTOMER_ID": "${GOOGLE_ADS_LOGIN_CUSTOMER_ID}"
      }
    },
    "tiktok-ads": {
      "command": "python",
      "args": [
        "${TIKTOK_ADS_MCP_PATH}/run_server.py"
      ],
      "env": {
        "TIKTOK_APP_ID": "${TIKTOK_APP_ID}",
        "TIKTOK_APP_SECRET": "${TIKTOK_APP_SECRET}",
        "TIKTOK_ACCESS_TOKEN": "${TIKTOK_ACCESS_TOKEN}"
      }
    },
    "tiktok-trends": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://api.trendsmcp.ai/mcp",
        "--header",
        "Authorization:Bearer ${TRENDSMCP_API_KEY}"
      ],
      "env": {
        "TRENDSMCP_API_KEY": "${TRENDSMCP_API_KEY}"
      }
    },
    "google-analytics": {
      "command": "ga4-mcp-server",
      "args": [],
      "env": {
        "GOOGLE_APPLICATION_CREDENTIALS": "${GA4_SERVICE_ACCOUNT_PATH}",
        "GA4_PROPERTY_ID": "${GA4_PROPERTY_ID}"
      }
    },
    "n8n": {
      "command": "npx",
      "args": [
        "-y",
        "n8n-mcp"
      ],
      "env": {
        "N8N_API_URL": "${N8N_API_URL}",
        "N8N_API_KEY": "${N8N_API_KEY}"
      }
    },
    "whatsapp": {
      "command": "uv",
      "args": [
        "--directory",
        "${WHATSAPP_MCP_PATH}/whatsapp-mcp-server",
        "run",
        "main.py"
      ],
      "env": {}
    },
    "shopify": {
      "command": "npx",
      "args": [
        "-y",
        "shopify-mcp",
        "--clientId",
        "${SHOPIFY_CLIENT_ID}",
        "--clientSecret",
        "${SHOPIFY_CLIENT_SECRET}",
        "--domain",
        "${SHOPIFY_STORE_DOMAIN}"
      ],
      "env": {}
    },
    "google-trends": {
      "command": "uvx",
      "args": ["google-news-trends-mcp@latest"]
    },
    "firecrawl": {
      "command": "npx",
      "args": ["-y", "firecrawl-mcp"],
      "env": {
        "FIRECRAWL_API_KEY": "fc-37c993dd291d45b4986e0fc0cd6e6317"
      }
    },
    "tavily": {
      "command": "npx",
      "args": ["-y", "tavily-mcp@latest"],
      "env": {
        "TAVILY_API_KEY": "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"
      }
    },
    "kindly-web-search": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/Shelpuk-AI-Technology-Consulting/kindly-web-search-mcp-server",
        "kindly-web-search-mcp-server",
        "start-mcp-server"
      ],
      "env": {
        "SEARXNG_BASE_URL": "https://search.canine.tools",
        "TAVILY_API_KEY": "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"
      }
    },
    "keywordtool-guest": {
      "command": "npx",
      "args": ["-y", "mcp-remote", "https://mcp.keywordtool.io/guest"]
    },
    "elevenlabs": {
      "command": "uvx",
      "args": ["elevenlabs-mcp"],
      "env": {
        "ELEVENLABS_API_KEY": "${ELEVENLABS_API_KEY}",
        "ELEVENLABS_MCP_BASE_PATH": "E:/Claude Code/#youtube/output/audio",
        "ELEVENLABS_MCP_OUTPUT_MODE": "files"
      }
    },
    "youtube-studio": {
      "command": "uvx",
      "args": ["youtube-studio-mcp"],
      "env": {
        "YOUTUBE_MCP_CLIENT_SECRET": "${YOUTUBE_CLIENT_SECRET_PATH}",
        "YOUTUBE_API_KEY": "${YOUTUBE_API_KEY}"
      }
    },
    "youtube-uploader": {
      "command": "${YOUTUBE_UPLOADER_BINARY}",
      "args": [
        "-client_secret_file",
        "${YOUTUBE_CLIENT_SECRET_PATH}"
      ]
    },
    "higgsfield": {
      "command": "python",
      "args": [
        "-m",
        "higgsfield_mcp.server"
      ],
      "cwd": "E:/Claude Code/#youtube/_mcp-servers/higgsfield_ai_mcp",
      "env": {
        "HF_API_KEY": "${HF_API_KEY}",
        "HF_SECRET": "${HF_SECRET}"
      }
    }
  }
}
